# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database
POSTGRES_USER=crypto_bot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=crypto_discipline
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://crypto_bot:change_me_strong_password@db:5432/crypto_discipline
ALEMBIC_DATABASE_URL=postgresql+psycopg2://crypto_bot:change_me_strong_password@db:5432/crypto_discipline

# AI Providers
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (LOCAL LLM — бесплатная альтернатива)
# Если задано — Ollama используется ВМЕСТО OpenAI/Anthropic.
# Внутри Docker на Windows/Mac: http://host.docker.internal:11434
# На Linux Docker: http://172.17.0.1:11434 (или --add-host)
# Без Docker: http://localhost:11434
# Чтобы выключить Ollama — просто оставь пустым.
OLLAMA_BASE_URL=
OLLAMA_MODEL_COACH=llama3.1:8b
OLLAMA_MODEL_OFFICER=llama3.1:8b

# API
API_HOST=0.0.0.0
API_PORT=8000

# Signal Bot integration (the separate market-scanning bot on port 8765)
# Inside Docker on Windows/Mac: host.docker.internal:8765
# On Linux Docker:               172.17.0.1:8765 (or use --network host)
# Without Docker (local Python): http://localhost:8765
SIGNAL_BOT_URL=http://host.docker.internal:8765

# Defaults (risk policy)
DEFAULT_MAX_RISK_PERCENT=1.0
DEFAULT_MAX_LEVERAGE=5
DEFAULT_MIN_RR=2.0
DEFAULT_DAILY_LOSS_LIMIT=2.0

# Logging
LOG_LEVEL=INFO
