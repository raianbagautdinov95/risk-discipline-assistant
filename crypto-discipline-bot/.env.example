# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database — the single source of truth for the DB connection.
# The app builds the async (asyncpg) and Alembic (psycopg2) URLs from these,
# so the password lives in exactly one place.
# HOST/PORT are as seen from the app: inside Docker use db:5432; running the
# app locally against the compose DB use localhost:5433.
POSTGRES_USER=crypto_bot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=crypto_discipline
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: set these ONLY to override the auto-built URLs above
# (e.g. an external managed database). Leave empty otherwise.
# DATABASE_URL=
# ALEMBIC_DATABASE_URL=

# AI Providers
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (LOCAL LLM — free alternative)
# If set, Ollama is used INSTEAD OF OpenAI/Anthropic.
# Inside Docker on Windows/Mac: http://host.docker.internal:11434
# On Linux Docker: http://172.17.0.1:11434 (or --add-host)
# Without Docker: http://localhost:11434
# Leave empty to disable Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL_COACH=llama3.1:8b
OLLAMA_MODEL_OFFICER=llama3.1:8b

# API
API_HOST=0.0.0.0
API_PORT=8000

# Signal Bot integration (the separate market-scanning bot on port 8765)
# Inside Docker on Windows/Mac: host.docker.internal:8765
# On Linux Docker:               172.17.0.1:8765 (or use --network host)
# Without Docker (local Python): http://localhost:8765
SIGNAL_BOT_URL=http://host.docker.internal:8765

# Defaults (risk policy)
DEFAULT_MAX_RISK_PERCENT=1.0
DEFAULT_MAX_LEVERAGE=5
DEFAULT_MIN_RR=2.0
DEFAULT_DAILY_LOSS_LIMIT=2.0

# Logging
LOG_LEVEL=INFO
